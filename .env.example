# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uemp"

# Used only by `npm test` (the test suite resets this database)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uemp_test"

PORT=4000
NODE_ENV=development

# Origin of the Vite dev server, allowed to call the API in development
WEB_ORIGIN="http://localhost:5173"

# Session lifetime in hours
SESSION_TTL_HOURS=8
