{
  "name": "uemp",
  "private": true,
  "version": "1.0.0",
  "description": "University Education Management Portal",
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "build": "npm run build -w web && npm run build -w api",
    "start": "npm run start -w api",
    "test": "npm run test -w api",
    "typecheck": "npm run typecheck -w api && npm run typecheck -w web",
    "db:migrate": "npm run db:migrate -w api",
    "db:seed": "npm run db:seed -w api",
    "db:reset": "npm run db:reset -w api"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true
  }
}
